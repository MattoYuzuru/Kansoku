{
  "schema_version": "kansoku.codex-inventory-layouts/1",
  "fixture_version": "1.0.0",
  "synthetic": true,
  "purpose": "codex_home_multi_surface_and_project_scope_inventory_layout_tests_required_by_skill-evidence-and-reconciliation.yaml_required_tests",
  "layouts": [
    {
      "name": "codex_home_env_var_resolved_single_cli_surface",
      "note": "CODEX_HOME_set_resolves_before_the_documented_default_state_root_a_single_cli_surface_marker_present",
      "codex_home_env_set": true,
      "codex_home_value_relpath": "custom-codex-home",
      "surface_markers_present": ["config.toml"],
      "expected_surfaces_detected": ["codex-cli"],
      "expected_candidate_count": 1
    },
    {
      "name": "codex_home_absent_falls_back_to_documented_default",
      "note": "CODEX_HOME_unset_or_absent_falls_back_to_the_documented_default_state_root_only_after_the_env_var_check_never_a_speculative_home_scan",
      "codex_home_env_set": false,
      "documented_default_state_root": "~/.codex",
      "expected_resolution_order": ["CODEX_HOME", "documented_default_state_root"]
    },
    {
      "name": "multi_surface_shared_state_root_cli_and_ide_extension",
      "note": "two_distinct_surface_markers_beneath_one_shared_state_root_must_remain_two_distinct_installation_candidates_never_merged_solely_because_they_share_a_state_root",
      "surface_markers_present": ["config.toml", "ide-extension.json"],
      "expected_surfaces_detected": ["codex-cli", "codex-ide-extension"],
      "expected_candidate_count": 2,
      "expected_shared_state_root": true
    },
    {
      "name": "multi_surface_all_three_surfaces_present",
      "note": "cli_ide_extension_and_app_surface_markers_all_present_beneath_one_state_root_three_distinct_candidates",
      "surface_markers_present": ["config.toml", "ide-extension.json", "app.json"],
      "expected_surfaces_detected": ["codex-cli", "codex-ide-extension", "codex-app"],
      "expected_candidate_count": 3
    },
    {
      "name": "project_scope_explicit_repository_target",
      "note": "repository_roots_are_scanned_only_for_a_known_active_project_or_an_explicit_user_target_never_a_speculative_recursive_filesystem_walk_this_layout_supplies_exactly_one_explicit_absolute_repository_target",
      "installation_id": "inst-project-scope-1",
      "repository_targets": ["/private/tmp/kansoku-fixture/codex-project-a"],
      "skills": [
        {"name": "project-local-skill", "scope": "repository", "enabled": true, "description_bytes": 200, "description_chars": 198}
      ],
      "expected_repository_target_count": 1,
      "expected_repository_target_must_be_absolute": true
    },
    {
      "name": "project_scope_relative_target_rejected",
      "note": "a_relative_repository_target_must_be_rejected_never_silently_resolved_against_an_implicit_cwd",
      "installation_id": "inst-project-scope-2",
      "repository_targets": ["relative/path/not/allowed"],
      "expect_error": "codex_inventory_repository_target_must_be_absolute"
    },
    {
      "name": "cache_only_plugin_never_enabled_even_with_active_installation_target",
      "note": "a_plugin_cache_artifact_requires_an_explicit_enabled_for_edge_before_it_is_ever_reported_enabled_cache_presence_alone_is_never_enabled",
      "installation_id": "inst-cache-1",
      "plugins": [
        {"name": "cached-only-plugin", "scope": "plugin_cache", "cached_only": true, "active_enabled_for": "inst-cache-1"}
      ],
      "expected_node_kind": "cache_artifact",
      "expected_enabled_for_edge": false
    },
    {
      "name": "hook_enabled_but_untrusted_never_gets_enabled_edge",
      "note": "kansoku_never_bypasses_or_silently_repairs_codex_hook_trust_an_enabled_but_untrusted_hook_must_never_receive_an_enabled_for_edge",
      "installation_id": "inst-hook-trust-1",
      "hooks": [
        {"name": "third-party-hook", "scope": "user", "enabled": true, "trusted": false}
      ],
      "expected_enabled_for_edge": false
    },
    {
      "name": "hook_enabled_and_trusted_gets_enabled_edge",
      "installation_id": "inst-hook-trust-2",
      "hooks": [
        {"name": "kansoku-observer-hook", "scope": "user", "enabled": true, "trusted": true}
      ],
      "expected_enabled_for_edge": true
    },
    {
      "name": "mcp_server_and_tool_nodes_with_collision",
      "note": "two_mcp_server_instances_sharing_one_declared_name_across_scopes_remain_distinct_nodes_linked_by_collides_with_never_merged",
      "installation_id": "inst-mcp-collision-1",
      "mcp_servers": [
        {"name": "echo-mcp", "scope": "user", "enabled": true, "advertised_tools": ["echo"]},
        {"name": "echo-mcp", "scope": "repository", "enabled": true, "advertised_tools": ["echo", "echo_batch"]}
      ],
      "expected_distinct_server_node_count": 2,
      "expected_collision_edge": true
    }
  ]
}
