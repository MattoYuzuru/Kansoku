{
  "name": "kansoku-web",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "Kansoku Session 10 dashboard frontend (React + wouter + TanStack Query + ECharts).",
  "license": "SEE THIRD_PARTY_LICENSES.txt",
  "scripts": {
    "gen:routes": "node scripts/gen-routes.mjs",
    "gen:icons": "node scripts/build-icons.mjs",
    "prebuild": "node scripts/gen-routes.mjs",
    "build": "tsc --noEmit && vite build",
    "dev": "node scripts/gen-routes.mjs && vite",
    "preview": "vite preview",
    "test:component-catalog": "node --experimental-strip-types --test tests/componentCatalog.test.ts",
    "test:format": "node --experimental-strip-types --test tests/format.test.ts",
    "test:range-preference": "node --experimental-strip-types --test tests/rangePreference.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:a11y-tokens": "node scripts/verify-accessibility-tokens.mjs",
    "verify:system-browser": "node scripts/verify-system-browser.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "echarts": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.7.2",
    "vite": "6.3.6"
  }
}
